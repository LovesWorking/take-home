{
  "name": "take-home",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "server": "pnpm --filter @take-home/server dev",
    "web": "pnpm --filter @take-home/web dev",
    "mobile": "pnpm --filter @take-home/mobile start",
    "ios": "pnpm --filter @take-home/mobile ios",
    "android": "pnpm --filter @take-home/mobile android",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "typescript": "~5.9.2"
  }
}
