{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"],
      "@buoy-gg/core": ["../node_modules/@buoy-gg/core/lib/typescript/module/index.web.d.ts"],
      "@buoy-gg/license": ["../node_modules/@buoy-gg/license/lib/typescript/module/index.web.d.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
